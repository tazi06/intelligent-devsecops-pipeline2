{
  "$schema": "https://opencode.ai/config.json",
  "model": "kaggle/qwen2.5-coder-7b",
  "providers": {
    "kaggle": {
      "name": "Kaggle vLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["KAGGLE_API_KEY"],
      "settings": {
        "baseURL": "{env:KAGGLE_BASE_URL}"
      },
      "models": {
        "qwen2.5-coder-7b": {
          "name": "Qwen2.5-Coder-7B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 4096,
            "output": 2048
          }
        }
      }
    }
  }
}